+/**
+ * Forme vocalisée (avec harakat) de chaque nom, indexée par l'id de names.ts.
+ *
+ * - names.ts n'est pas modifié : son champ `arabic` reste la référence (recherche, comparaisons).
+ * - Chaque forme ci-dessous contient exactement les mêmes lettres que `arabic` dans names.ts ;
+ *   seules les voyelles et signes (fatha, kasra, damma, sukun, shadda, tanwin, alif suscrit) sont ajoutés.
+ * - Choix de rédaction : forme de citation avec la damma finale (ex. الرَّحِيمُ), lam de l'article
+ *   avec sukun devant les lettres lunaires (الْغَفُورُ), sans signe devant les lettres solaires (الرَّحِيمُ).
+ *
+ * À FAIRE VALIDER avant toute mise en ligne.
+ */
+export const namesVocalized: Record<number, string> = {
+  1: 'اللَّهُ',
+  2: 'الرَّحْمَٰنُ',
+  3: 'الرَّحِيمُ',
+  4: 'الْعَفُوُّ',
+  5: 'الْغَفُورُ',
+  6: 'الْغَفَّارُ',
+  7: 'الرَّؤُوفُ',
+  8: 'الْحَلِيمُ',
+  9: 'التَّوَّابُ',
+  10: 'السِّتِّيرُ',
+  11: 'الْغَنِيُّ',
+  12: 'الْكَرِيمُ',
+  13: 'الْأَكْرَمُ',
+  14: 'الْوَهَّابُ',
+  15: 'الْجَوَادُ',
+  16: 'الْوَدُودُ',
+  17: 'الْمُعْطِي',
+  18: 'الْوَاسِعُ',
+  19: 'الْمُحْسِنُ',
+  20: 'الرَّازِقُ',
+  21: 'الرَّزَّاقُ',
+  22: 'اللَّطِيفُ',
+  23: 'الْخَبِيرُ',
+  24: 'الْفَتَّاحُ',
+  25: 'الْعَلِيمُ',
+  26: 'الْبَرُّ',
+  27: 'الْحَكِيمُ',
